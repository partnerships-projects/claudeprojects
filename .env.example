# Notion API Configuration
# Create an integration at https://www.notion.so/my-integrations
NOTION_API_KEY=ntn_xxxxxxxxxxxxxxxxxxxx

# Notion Database IDs (found in the URL of each database page)
# e.g., https://notion.so/workspace/<DATABASE_ID>?v=...
NOTION_CLIENT_BOARD_DB_ID=
NOTION_ACTIVE_CLIENTS_DB_ID=
NOTION_CLIENT_FEEDBACK_DB_ID=
NOTION_CAMPAIGN_PERFORMANCE_DB_ID=

# Anthropic API Key for AI-powered summaries
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Report Configuration
REPORT_OUTPUT_FORMAT=notion
# Options: notion (writes back to Notion), console (prints to terminal), both
